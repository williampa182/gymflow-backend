{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add*": "ask",
      "git commit*": "deny",
      "git push*": "deny",
      ".\\mvnw.cmd*": "allow",
      "mvnw.cmd*": "allow"
    }
  },
  "agent": {
    "build": {
      "permission": {
        "bash": {
          "*": "ask",
          "git commit*": "deny",
          "git push*": "deny"
        }
      }
    }
  }
}

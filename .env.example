# Variables de entorno de gymflow-backend.
# Copiar a .env (o exportarlas como env vars reales) y ajustar según el
# entorno. Todos los valores acá son defaults de DESARROLLO LOCAL — los
# mismos que ya trae application.yaml via ${VAR:default}, documentados acá
# para no tener que leer el yaml completo. En producción (Render) estas
# variables se configuran como secrets/env vars de la plataforma, nunca
# committeadas.

# --- Base de datos (Postgres) ---
# Deben coincidir con docker-compose.yml si se usa el entorno local.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gymflow_db
DB_USER=gymflow_user
DB_PASSWORD=gymflow_pass

# En local, Hibernate ajusta el esquema automáticamente (update). En
# producción usar "validate" y migraciones controladas (Flyway/Liquibase).
DDL_AUTO=update

# Loguea cada query con parámetros reales (emails, hashes) a stdout.
# Solo activar en dev local para debug puntual; nunca en producción.
SHOW_SQL=false

# --- Redis ---
# REDIS_PASSWORD debe coincidir con el que usa docker-compose.yml para el
# contenedor de Redis.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=gymflow_redis_dev_only_change_me

# --- Servidor (Tomcat) ---
SERVER_PORT=8080
MAX_HTTP_REQUEST_HEADER_SIZE=8KB
MAX_HTTP_FORM_POST_SIZE=2MB
MAX_SWALLOW_SIZE=2MB

# --- Manejo de errores ---
# "never" oculta stack traces / mensajes / errores de binding en las
# respuestas de error, independientemente del perfil activo.
ERROR_INCLUDE_STACKTRACE=never
ERROR_INCLUDE_MESSAGE=never
ERROR_INCLUDE_BINDING_ERRORS=never

# --- Actuator ---
HEALTH_SHOW_DETAILS=when-authorized

# --- Swagger / OpenAPI ---
# Expone toda la superficie de la API sin autenticación cuando está en
# true. Activar solo en dev/staging, nunca en producción pública.
SWAGGER_ENABLED=false

# --- JWT ---
# Placeholder DEV ONLY. En producción generar un secret nuevo y único con:
#   openssl rand -base64 64
# y configurarlo como env var en la plataforma (nunca commitear el valor
# real). El secret original de este proyecto quedó expuesto en un commit
# viejo y fue limpiado del historial con git-filter-repo — no reutilizar.
JWT_SECRET=dev-only-a8f3c91e2b7d4f60193a5c8e7b2d4f019a3c6e8b1d5f7a90c2e4b6d8f0a1c3e5
# Milisegundos (86400000 = 24h).
JWT_EXPIRATION=86400000
# Si AuthResponse incluye el token JWT en el JSON de login/register.
# Poner false cuando se use exclusivamente la cookie httpOnly.
JWT_INCLUDE_TOKEN_IN_RESPONSE=true

# --- Seguridad adicional ---
# Si /register revela cuando un email ya está registrado. false = mensaje
# genérico, consistente con el hardening contra timing attacks del login.
REVEAL_EMAIL_EXISTS=false

# CORS: origen(es) permitidos, separados por coma. En Render, la(s)
# URL(s) real(es) del frontend (ej: https://gymflow-frontend-ten.vercel.app).
ALLOWED_ORIGINS=http://localhost:3000

# --- Logging ---
# TRACE es útil en local para depurar el filtro JWT/auth. En producción
# fijar en WARN para no filtrar detalles de autenticación en logs.
SECURITY_LOG_LEVEL=TRACE

# --- Chat de soporte (Feature 1 del portafolio, RAG simple sobre planes) ---
# Proveedor activo: "anthropic" | "gemini". Gemini por ahora (decisión
# 2026-07-26): tier gratis real sin tarjeta mientras el proyecto no genera
# ingresos. Cambiar de proveedor es solo esta variable, ambos adaptadores
# ya están implementados (ver client/).
APP_CHAT_PROVIDER=gemini

# Gemini (proveedor activo por defecto).
# Placeholder de dev, no es una key real — cualquier llamada real con este
# valor devuelve 401/403, mapeado a 503 por GlobalExceptionHandler.
GEMINI_API_KEY=dev-only-placeholder-not-a-real-key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# Flash-Lite: el modelo más económico dentro del tier gratis de Gemini.
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite

# Anthropic (proveedor alternativo, documentado por si se cambia
# APP_CHAT_PROVIDER a "anthropic"). Mismo placeholder de dev.
ANTHROPIC_API_KEY=dev-only-placeholder-not-a-real-key
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Haiku 4.5: modelo más barato/rápido para respuestas cortas ancladas a
# contexto ya armado (RAG simple), no para razonamiento complejo.
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_CHAT_MAX_TOKENS=512

# --- Notificaciones de vencimiento (Resend) ---
# Placeholder de dev, no es una key real — cualquier llamada real con este
# valor devuelve 401/403 (mapeado a EmailEnvioException). En producción
# configurar la API key real de Resend como secret (nunca commitear).
RESEND_API_KEY=dev-only-placeholder-not-a-real-key
RESEND_BASE_URL=https://api.resend.com
# Remitente: en producción debe ser un dominio verificado en Resend
# (ej. "GymFlow <no-reply@midominio.com>").
EMAIL_FROM=no-reply@gymflow.com
# Días de anticipación con los que se avisa el vencimiento (ventana abierta).
EMAIL_AVISO_VENTANA_DIAS=7
# Base URL pública del frontend para el CTA "Renovar ahora" de los emails —
# debe coincidir con NEXT_PUBLIC_APP_ORIGIN del frontend.
EMAIL_CTA_BASE_URL=http://localhost:3000
# Apaga el job programado si se quiere (tests/CI lo fijan en false).
EMAIL_AVISO_ENABLED=true
# Cron del job diario (default: 09:00 hora local del servidor).
EMAIL_AVISO_CRON=0 0 9 * * *
